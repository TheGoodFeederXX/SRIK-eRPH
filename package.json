{
  "name": "erph",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host\" \"tsx watch server/index.ts\"",
    "dev:client": "vite --host",
    "dev:server": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "db:migrate": "tsx server/db/migrate.ts",
    "seed:dskp": "tsx server/db/seed-dskp.ts",
    "seed:admin": "tsx server/db/seed-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -b && vite build",
    "start": "node --import tsx server/index.ts",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/noto-sans-arabic": "^5.2.10",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "arabic-reshaper": "^1.1.0",
    "bidi-js": "^1.0.3",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "framer-motion": "^12.24.5",
    "lucide-react": "^0.562.0",
    "pdfmake": "^0.3.5",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/pdfmake": "^0.3.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.9"
  }
}
